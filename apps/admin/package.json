{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "check:api-exports": "node scripts/check-api-exports.mjs",
    "preview": "vite preview",
    "build:e2e": "VITE_API_URL=/api vite build --outDir e2e/.build/admin --emptyOutDir && VITE_API_URL=/api VITE_FORCE_SUBDOMAIN=sales vite build --outDir e2e/.build/sales --emptyOutDir",
    "test:e2e": "playwright test --config e2e/playwright.config.js",
    "test:e2e:docker": "pnpm run build:e2e && docker run --rm --init --ipc=host -v \"$PWD/e2e:/e2e\" -w /e2e mcr.microsoft.com/playwright:v1.61.1-noble bash -lc 'npm install --no-audit --no-fund && npx playwright test'"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@emotion/react": "^11.13.5",
    "@emotion/styled": "^11.13.5",
    "@mui/icons-material": "^6.3.0",
    "@mui/material": "^6.3.0",
    "@tanstack/react-query": "^5.66.0",
    "@twilio/voice-sdk": "^2.18.3",
    "axios": "^1.7.9",
    "dayjs": "^1.11.13",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "eslint": "^9.25.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "vite": "^6.3.5"
  }
}
