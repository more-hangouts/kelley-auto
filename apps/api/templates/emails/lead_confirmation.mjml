<!--
  SOURCE OF TRUTH for the customer lead-confirmation email.

  Edit this .mjml, then recompile to lead_confirmation.html:
      cd /opt/kelley/backend/templates/emails
      npx -y mjml lead_confirmation.mjml -o lead_confirmation.html

  The compiled .html keeps the {{ jinja }} placeholders untouched and is what
  the backend renders at send time (services/notification_templates.py). Only
  simple {{ variable }} substitutions are used here — NO {% %} control flow —
  so MjML never mangles them and every conditional is precomputed in Python.
-->
<mjml>
  <mj-head>
    <mj-title>{{ business_name }} — we got your request</mj-title>
    <mj-preview>{{ preheader }}</mj-preview>
    <mj-attributes>
      <mj-all font-family="-apple-system, Segoe UI, Roboto, Helvetica, Arial, sans-serif" />
      <mj-text font-size="15px" color="#2A1B1F" line-height="1.6" />
    </mj-attributes>
    <mj-style>
      .brand { color: #F76C45; }
    </mj-style>
  </mj-head>

  <mj-body background-color="#f4f4f5">
    <mj-section padding="24px 0 8px">
      <mj-column>
        <mj-text align="center" font-size="22px" font-weight="700" color="#F76C45">
          {{ business_name }}
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-section background-color="#ffffff" border-radius="14px" padding="8px 8px 16px">
      <mj-column>
        <mj-text font-size="20px" font-weight="700" padding-bottom="6px">
          Thanks, {{ greeting_name }} — we got your request!
        </mj-text>
        <mj-text>{{ interest_line }}</mj-text>
        <mj-text>{{ body_line }}</mj-text>

        <mj-button background-color="#F76C45" color="#ffffff" border-radius="10px"
                   font-weight="700" href="{{ browse_url }}" padding="16px 0 6px">
          Browse our inventory
        </mj-button>
        <mj-text align="center" font-size="13px" color="#6b6b70" padding-top="0">
          Prefer to talk now? Call us at
          <a href="tel:{{ phone_tel }}" style="color:#F76C45; text-decoration:none; font-weight:600;">{{ business_phone }}</a>
        </mj-text>

        <mj-divider border-width="1px" border-color="#eeeeee" padding="14px 0" />

        <mj-text font-size="12px" color="#9a9aa0" line-height="1.5">
          {{ business_name }}{{ footer_address }}<br />
          You're receiving this because you submitted a request at {{ site_host }}.
          This is not a credit decision — a team member will follow up personally.
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-section padding="8px 0 28px">
      <mj-column>
        <mj-text align="center" font-size="11px" color="#b5b5ba">
          © {{ current_year }} {{ business_name }}
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
