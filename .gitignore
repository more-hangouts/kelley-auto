# ---- Env (keep *.env.example, ignore real env files) ----
.env
.env.*
!.env.example
!**/.env.example

# ---- Node / Next.js / Vite ----
node_modules/
.next/
out/
dist/
build/
.pnpm-store/
.vercel/
*.tsbuildinfo

# ---- Staged release artifacts (deploy/stage-release.sh) ----
# Versioned builds and runtime release state live on the server only.
/releases/
# Legacy pointer from the initial staged-release design; no longer used because
# Next 15.5 cannot serve a symlink distDir.
apps/storefront/.next-current
apps/storefront/.next-releases/
apps/storefront/.next-stage-*
apps/storefront/.next-preview-*
apps/storefront/.next.promote.*
apps/storefront/.next.previous.*
apps/storefront/.next.failed.*
apps/storefront/.next-env.d.ts.stagebak
apps/storefront/.tsconfig.json.stagebak

# ---- E2E generated artifacts ----
apps/admin/e2e/.build/
apps/admin/e2e/node_modules/
apps/admin/e2e/test-results/
apps/admin/e2e/report/
apps/admin/e2e/package-lock.json

# ---- Python / FastAPI ----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
# Local convenience symlink at the repo root pointing at apps/api/.venv.
# The `.venv/` glob above only matches directories, not the symlink; no tracked
# script depends on the root symlink (build.sh and apps/api/scripts use
# apps/api/.venv directly), so ignore it here. Leave the symlink in place on disk.
/.venv
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ---- Databases / local data ----
*.sqlite
*.sqlite3
*.db
uploads/

# ---- Logs ----
*.log
logs/

# ---- Build/import artifacts we never commit ----
*.zip
coverage/
.cache/

# ---- OS / editor ----
.DS_Store
Thumbs.db
.idea/
.vscode/
