[Unit]
Description=Kelley Autoplex deal follow-up reminders (one pass)
# Oneshot pass fired by kelley-reminders.timer. Nothing here starts at boot;
# the timer owns the schedule. Safe to trigger by hand for a manual drain:
#   sudo systemctl start kelley-reminders.service
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=deploy
Group=deploy
WorkingDirectory=/opt/kelley/apps/api
EnvironmentFile=/opt/kelley/apps/api/.env
ExecStart=/opt/kelley/apps/api/.venv/bin/python scripts/run_note_reminders.py
# A failed pass is not fatal: reminder_sent_at stays NULL, so the next tick
# retries the same rows. No Restart= — the timer is the retry mechanism.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
